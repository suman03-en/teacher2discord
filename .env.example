# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Email (Brevo API via django-anymail)
DEFAULT_FROM_EMAIL=Your App <your-verified-sender@example.com>
BREVO_API_KEY=your-brevo-api-key

# Rate limiting
# Hard cap on magic-link emails per rolling 24h (keep below your Brevo daily quota)
MAGIC_LINK_GLOBAL_MAX_PER_DAY=250
# Reverse proxies in front of Django (Render/Heroku = 1, local/no proxy = 0)
TRUSTED_PROXY_COUNT=1